{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent_core Rule Reference",
  "description": "Validates [Agent_core:RuleID] reference format used across the ecosystem",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "pattern": "^\\[Agent_core:(P\\d+[a-z]?|P\\d+\\.\\d+|W-[A-Z]+-\\d+|Proto-[A-Z])\\]$",
      "description": "Full reference string in bracket notation"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^(P\\d+[a-z]?|P\\d+\\.\\d+|W-[A-Z]+-\\d+|Proto-[A-Z])$",
      "description": "Rule ID without bracket notation"
    },
    "prefix": {
      "type": "string",
      "enum": ["P", "W", "Proto"],
      "description": "Rule type prefix"
    }
  },
  "examples": [
    { "reference": "[Agent_core:P4a]", "rule_id": "P4a", "prefix": "P" },
    { "reference": "[Agent_core:W-DEV-1]", "rule_id": "W-DEV-1", "prefix": "W" },
    { "reference": "[Agent_core:Proto-C]", "rule_id": "Proto-C", "prefix": "Proto" },
    { "reference": "[Agent_core:P13.3]", "rule_id": "P13.3", "prefix": "P" }
  ]
}
